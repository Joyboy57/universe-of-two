# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Media lives in a private Supabase Storage bucket named "media" (no extra keys needed)

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Push notifications (generate keys with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects the daily notification job (any long random string)
CRON_SECRET=

# OPTIONAL: exact Spotify song search. Without these, song search uses Apple's free catalog and
# links open Spotify's search. (Spotify requires the app owner to have Premium for this.)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
